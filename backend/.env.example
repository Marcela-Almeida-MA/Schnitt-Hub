# Copie este arquivo para .env e substitua os valores localmente.
NODE_ENV=development
PORT=3333
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL local. Nunca coloque credenciais reais no Git.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/schnitt_hub
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Gere um segredo aleatório longo. Não use este exemplo em produção.
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
LOG_LEVEL=info
