{
  "name": "schnitt-hub-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST do Schnitt Hub para gestão de barbearias",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.5",
    "eslint": "^9.37.0",
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4",
    "supertest": "^7.1.4",
    "@types/supertest": "^6.0.3",
    "typescript-eslint": "^8.46.1"
  }
}
